<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>trex</groupId>
    <artifactId>trex</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>trex-grid</artifactId>

  <dependencies>
    <dependency>
      <groupId>trex</groupId>
      <artifactId>trex-core</artifactId>
    </dependency>
    <dependency>
      <groupId>trex</groupId>
      <artifactId>trex-journal</artifactId>
    </dependency>
    <dependency>
      <groupId>trex</groupId>
      <artifactId>trex-category</artifactId>
    </dependency>
    <dependency>
      <groupId>trex</groupId>
      <artifactId>trex-web</artifactId>
    </dependency>
    <!-- tests write real journals with the sequencer.s JsonlJournal -->
    <dependency>
      <groupId>trex</groupId>
      <artifactId>trex-sequencer</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The binding belongs to the runnable module, never to a library. -->
    <!-- CLI parsing, usage text and exit codes (SPEC §1 dependency policy). -->
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>trex.grid.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Container image: ${trex.image.prefix}/grid:${trex.image.tag}.
           Shared config (base image, non-root user, reproducible timestamps) is in
           the parent pom; only the name, entry point and ports differ here. -->
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <to>
            <image>${trex.image.prefix}/grid:${trex.image.tag}</image>
          </to>
          <container>
            <mainClass>trex.grid.Main</mainClass>
            <ports>
              <port>8091</port>
            </ports>
          </container>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
