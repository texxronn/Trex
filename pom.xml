<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>trex</groupId>
  <artifactId>trex</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>trex-core</module>
    <module>trex-journal</module>
    <module>trex-sequencer</module>
    <module>trex-ingress-ing</module>
    <module>trex-egress-archive</module>
    <module>trex-egress-sqlite</module>
    <module>trex-web</module>
    <module>trex-resolver</module>
    <module>trex-grid</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Reproducible builds: fixes the timestamps Maven writes into jar entries.
         Without it every rebuild produces different jar bytes, which lands in the
         image as a different dependency layer and a different digest. -->
    <project.build.outputTimestamp>2026-09-18T00:00:00Z</project.build.outputTimestamp>
    <jackson.version>2.18.1</jackson.version>
    <sqlite-jdbc.version>3.46.0.0</sqlite-jdbc.version>
    <junit.version>5.11.0</junit.version>

    <!-- Container images (jib). See README "Container images". -->
    <jib.version>3.4.6</jib.version>
    <!-- Only the six service modules build an image; jib is skipped everywhere else. -->
    <jib.skip>true</jib.skip>
    <!-- Base image pinned by digest: reproducible builds need an immutable base.
         This is eclipse-temurin:25-jre as of 2026-09-18. To move it, re-resolve the
         digest (README) — never drop the pin. -->
    <trex.image.base>eclipse-temurin@sha256:611e326900ba9edcedfb246ede24efc66a911fa496ac623db9f33cae88a2d83b</trex.image.base>
    <trex.image.prefix>trex</trex.image.prefix>
    <trex.image.tag>${project.version}</trex.image.tag>
    <trex.image.os>linux</trex.image.os>
    <trex.image.arch>amd64</trex.image.arch>
    <!-- Matches deploy/config/trex.env. Override at runtime with JAVA_TOOL_OPTIONS. -->
    <trex.image.jvmflags>-XX:+UseSerialGC</trex.image.jvmflags>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>trex</groupId>
        <artifactId>trex-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>trex</groupId>
        <artifactId>trex-journal</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>trex</groupId>
        <artifactId>trex-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>trex</groupId>
        <artifactId>trex-sequencer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.datatype</groupId>
        <artifactId>jackson-datatype-jsr310</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>25</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>com.google.cloud.tools</groupId>
          <artifactId>jib-maven-plugin</artifactId>
          <version>${jib.version}</version>
          <configuration>
            <skip>${jib.skip}</skip>
            <from>
              <image>${trex.image.base}</image>
              <platforms>
                <platform>
                  <os>${trex.image.os}</os>
                  <architecture>${trex.image.arch}</architecture>
                </platform>
              </platforms>
            </from>
            <container>
              <!-- Override the labels inherited from the base image, which otherwise
                   describe Ubuntu rather than trex. -->
              <labels>
                <org.opencontainers.image.title>${project.artifactId}</org.opencontainers.image.title>
                <org.opencontainers.image.description>${project.artifactId} — part of trex</org.opencontainers.image.description>
                <org.opencontainers.image.version>${project.version}</org.opencontainers.image.version>
                <org.opencontainers.image.base.name>${trex.image.base}</org.opencontainers.image.base.name>
              </labels>
              <!-- Non-root. Temurin has no service account, so use a plain uid:gid;
                   the compose volumes are chowned to the same pair. -->
              <user>1000:1000</user>
              <workingDirectory>/var/lib/trex</workingDirectory>
              <jvmFlags>
                <jvmFlag>${trex.image.jvmflags}</jvmFlag>
              </jvmFlags>
              <!-- Reproducible: fixed timestamps, so identical inputs give an
                   identical digest. Both are jib defaults; pinned here on purpose. -->
              <creationTime>EPOCH</creationTime>
              <filesModificationTime>EPOCH_PLUS_SECOND</filesModificationTime>
            </container>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- mvn package -Pdocker        → build all six images into the Docker daemon
         mvn package -Pdocker-push   → push all six to ${trex.image.prefix}
         Both honour DOCKER_HOST; see deploy/bin/trex-docker.sh for Docker contexts. -->
    <profile>
      <id>docker</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>com.google.cloud.tools</groupId>
              <artifactId>jib-maven-plugin</artifactId>
              <executions>
                <execution>
                  <id>build-image</id>
                  <phase>package</phase>
                  <goals>
                    <goal>dockerBuild</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
    <profile>
      <id>docker-push</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>com.google.cloud.tools</groupId>
              <artifactId>jib-maven-plugin</artifactId>
              <executions>
                <execution>
                  <id>push-image</id>
                  <phase>package</phase>
                  <goals>
                    <goal>build</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
