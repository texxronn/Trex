# Shared dev settings — sourced by every script in deploy/dev/bin.
# Anything here can be overridden from the environment before starting a panel.

# Bind address for all three HTTP services. Loopback: none of them authenticate.
TREX_BIND="${TREX_BIND:-127.0.0.1}"

# Ports. Must match bindPort in config/sequencer.yaml for the sequencer.
# TREX_ADMIN_PORT is trex-ws's loopback-only admin listener; TREX_WEB_PORT is its
# read listener, the one that serves pages and may bind elsewhere (SPEC §5.7).
TREX_SEQ_PORT="${TREX_SEQ_PORT:-8080}"
TREX_ADMIN_PORT="${TREX_ADMIN_PORT:-8085}"
TREX_WEB_PORT="${TREX_WEB_PORT:-8090}"

# Run directory: journal, archive, sqlite db, pid files. Wiped by bin/reset.sh.
TREX_DEV_RUN="${TREX_DEV_RUN:-$TREX_DEV/run}"

# Dev log level: debug adds per-append head offsets, 4xx responses and SSE
# connect/disconnect. trace adds one line per journal line on replay.
TREX_LOG_LEVEL="${TREX_LOG_LEVEL:-debug}"

JAVA_OPTS="${JAVA_OPTS:--Xms64m -Xmx256m -XX:+UseSerialGC}"
