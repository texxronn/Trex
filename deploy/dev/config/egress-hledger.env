# trex-egress-hledger — dev flags (SPEC.md §5.9, §6). Sourced by
# bin/egress-hledger.sh and turned into --gateway-url / --out / --accounts.
#
# Paths may be absolute or relative to deploy/dev/run.

# Where to write the journal. Regenerated whole on every run, through a temp file
# and a rename, so a reader never sees half a file.
OUT="${OUT:-hledger/trex.journal}"

# Empty → http://127.0.0.1:$TREX_GATEWAY_PORT from trex-dev.env.
GATEWAY_URL="${GATEWAY_URL:-}"

# Account tree + income categories.
ACCOUNTS="${ACCOUNTS:-$TREX_DEV/config/hledger.yaml}"

# NO_ASSERT=1 → omit balance assertions. They are the reason this egress exists,
# so this is only for diagnosing a file that will not load at all.
NO_ASSERT="${NO_ASSERT:-0}"

# Handy after a run:
#   hledger -f deploy/dev/run/hledger/trex.journal check accounts ordereddates assertions
#   hledger -f deploy/dev/run/hledger/trex.journal bal assets liabilities --flat -N
#   hledger -f deploy/dev/run/hledger/trex.journal bal assets:unresolved -N
