# trex-egress-archive — dev flags (SPEC.md §5.2, §6). The follower takes flags,
# not a TOML file; this file is sourced by bin/egress-archive.sh and turned into
# --journal / --archive / --poll-seconds.
#
# Paths may be absolute or relative to deploy/dev/run.

JOURNAL="journal/journal.jsonl"
ARCHIVE="archive/archive.jsonl"

# Fallback wake interval. The follower wakes on journal change events; this is
# only the backstop, so a small dev value costs nothing.
POLL_SECONDS=5

# ONCE=1 → drain what is already in the journal, print, exit (no tailing).
ONCE=0
