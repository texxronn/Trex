# trex-resolver — dev flags (SPEC.md §5.4, §6). Sourced by bin/resolver.sh.
#
# The resolver tails the journal for its own view and calls the sequencer API to
# make decisions, so both must be reachable. Decisions are final: there is no
# undo, which is why the UI double-confirms.

JOURNAL="journal/journal.jsonl"

# Empty → http://$TREX_BIND:$TREX_SEQ_PORT from trex-dev.env.
SEQUENCER_URL=""

# Tail poll interval in ms; the WatchService wake is primary.
POLL_MS=500
