# trex-ws — dev flags (SPEC.md §5.7, §6). Sourced by bin/ws.sh.
#
# The consumer API: it tails the journal, applies categories.yaml and pins.yaml,
# and forwards decisions to the sequencer. trex-web is a client of this, and so is
# anything else that wants the journal materialised rather than raw.
#
# Loopback only, and not by habit: it writes the rule files and forwards decisions,
# and it has no authentication. Expose trex-web instead — that is the one with pages.

JOURNAL="${JOURNAL:-journal/journal.jsonl}"

# Empty → http://$TREX_BIND:$TREX_SEQ_PORT from trex-dev.env.
SEQUENCER_URL="${SEQUENCER_URL:-}"

# Config directory holding categories.yaml and pins.yaml (SPEC.md §5.6, §6).
# categories.yaml is hand-written and ordered; pins.yaml is written by this service
# as well as by hand, which is why a pin's rationale is a `comment:` field and not a
# `#` line — a machine rewrite cannot reproduce a `#` line.
CONFIG="${CONFIG:-$TREX_DEV/config}"

# Tail poll interval in ms; the WatchService wake is primary.
POLL_MS="${POLL_MS:-500}"
