# trex-web — dev flags (SPEC.md §5.4, §6). Sourced by bin/web.sh.
#
# One service: browsing at / and the resolution workflow at /resolve. It tails
# the journal for its own view and calls the sequencer API to make decisions, so
# both must be reachable to resolve. Decisions are final; the UI double-confirms.

JOURNAL="${JOURNAL:-journal/journal.jsonl}"

# Empty → http://$TREX_BIND:$TREX_SEQ_PORT from trex-dev.env.
SEQUENCER_URL="${SEQUENCER_URL:-}"

# Config directory holding categories.yaml and pins.yaml (SPEC.md §5.6, §6).
# categories.yaml is hand-written and ordered; pins.yaml is written by the service
# as well as by hand, which is why a pin's rationale is a `comment:` field and not
# a `#` line — a machine rewrite cannot reproduce a `#` line.
CONFIG="${CONFIG:-$TREX_DEV/config}"

# Tail poll interval in ms; the WatchService wake is primary.
POLL_MS="${POLL_MS:-500}"
