# trex-web — dev flags (SPEC.md §5.4). Sourced by bin/web.sh.
#
# Pages and a proxy. It holds no journal state, reads no config file and knows one
# upstream: trex-gateway. Start that first, or the page loads and reports it cannot
# reach the gateway — which is the honest thing for it to say.
#
# Empty → http://$TREX_BIND:$TREX_GATEWAY_PORT from trex-dev.env.
GATEWAY_URL="${GATEWAY_URL:-}"
