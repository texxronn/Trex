# trex-egress-firefly — dev flags (SPEC.md §5.8, §6). Sourced by
# bin/egress-firefly.sh.
#
# The token is NOT here and must not be: a token in config ends up in git, and
# §6 says so. Export FIREFLY_TOKEN, or put it in ~/.config/trex/firefly.env and
# source that before starting the panel.

# Empty → http://127.0.0.1:$TREX_GATEWAY_PORT from trex-dev.env.
GATEWAY_URL="${GATEWAY_URL:-}"

# The dev Firefly instance.
FIREFLY_URL="${FIREFLY_URL:-http://127.0.0.1:8083}"

# ref → Firefly account name and type. Names must match the dev instance, and
# startup refuses to run if one does not, rather than posting into the wrong place.
ACCOUNTS="${ACCOUNTS:-$TREX_DEV/config/firefly.yaml}"

# Empty → the cache lives in memory and is rebuilt from Firefly at startup. That
# is the same path --verify takes, so it is exercised every run rather than being
# an emergency path that has never executed.
CACHE="${CACHE:-}"

# Attempts per request for TRANSIENT failures only — a dropped connection, a 5xx
# or a 429. A 4xx is never retried and stops the pass, naming the transaction.
RETRIES="${RETRIES:-3}"
RETRY_BASE_MS="${RETRY_BASE_MS:-500}"
RETRY_MAX_MS="${RETRY_MAX_MS:-15000}"
