# trex-ingress-ing — dev flags (SPEC.md §4, §6). Sourced by bin/ingest.sh.
# The adapter is a one-shot CLI, not a service: it validates the whole file and
# sends nothing if any row is bad.

# Empty → http://$TREX_BIND:$TREX_SEQ_PORT from trex-dev.env.
SEQUENCER_URL="${SEQUENCER_URL:-}"

# Rows per POST. Batching is day-atomic: a day is never split across batches, so
# a small value here still sends whole days.
BATCH_ROWS="${BATCH_ROWS:-500}"

# GZIP=0 adds --no-gzip, to watch the uncompressed bodies on the wire.
GZIP="${GZIP:-1}"
