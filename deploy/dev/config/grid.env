# trex-grid — dev flags (SPEC.md §5.5, §6). Sourced by bin/grid.sh.
# Read-only: the grid never writes the journal and never calls the sequencer.

JOURNAL="${JOURNAL:-journal/journal.jsonl}"

# Category rules (SPEC.md §5.6). Missing file → every row is UNCATEGORIZED.
CATEGORIES="${CATEGORIES:-$TREX_DEV/config/categories.yaml}"

# Tail poll interval in ms; SSE head events push updates to the browser.
POLL_MS="${POLL_MS:-500}"
