# trex-egress-sqlite — dev flags (SPEC.md §5.3, §6). Sourced by
# bin/egress-sqlite.sh and turned into --journal / --db / --poll-seconds.
#
# Paths may be absolute or relative to deploy/dev/run.

JOURNAL="journal/journal.jsonl"
DB="sqlite/trex.db"

POLL_SECONDS=5

# ONCE=1 → project what is already in the journal, then exit.
ONCE=0

# Handy while testing:
#   sqlite3 deploy/dev/run/sqlite/trex.db '.tables'
#   sqlite3 deploy/dev/run/sqlite/trex.db 'select n, external_id, state from events order by n'
