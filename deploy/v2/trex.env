# Shared environment for the trex v2 systemd units (EnvironmentFile=/etc/trex/trex.env).
# JVM options applied to every trex process. Values must not contain spaces:
# systemd splits $JAVA_OPTS on whitespace.
JAVA_OPTS=-Xms64m -Xmx512m -XX:+UseSerialGC

# The Firefly base URL for trex-egress-firefly.service. Uncomment and set it.
# TREX_FIREFLY_URL=http://127.0.0.1:8081

# trex-ingest@.service reads these; the statement path is the unit instance (%i).
# TREX_SOURCE_TYPE=ing-csv
# TREX_ACCOUNT=ing-savings
