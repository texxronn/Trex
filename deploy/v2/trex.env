# Shared environment for the trex v2 systemd units (EnvironmentFile=/etc/trex/trex.env).
# JVM options applied to every trex process. Values must not contain spaces:
# systemd splits $JAVA_OPTS on whitespace.
JAVA_OPTS=-Xms64m -Xmx512m -XX:+UseSerialGC

# The instance label: stamped into every log line's envelope and shown in the hub header
# (Dev1 / Prod / Prod-IN). At most 8 characters.
# TREX_ENV=Dev1

# The Firefly base URL for the runner's dormant egress projection (V2-SPEC.md §11.1).
# Uncomment and set it.
# TREX_FIREFLY_URL=http://127.0.0.1:8081

# The ezbookkeeping base URL for the runner's live egress view (V2-SPEC.md §11.2). Uncomment and set it.
# TREX_EZB_URL=http://127.0.0.1:8095
# The ezbookkeeping API token goes in EZB_TOKEN in the runner's environment (never a flag);
# clearing needs no account password (§11.2).

# trex-ingest@.service reads these; the statement path is the unit instance (%i).
# TREX_SOURCE_TYPE=ing-csv
# TREX_ACCOUNT=ing-savings
