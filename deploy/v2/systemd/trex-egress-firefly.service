[Unit]
Description=trex v2 Firefly plan (diff only; --apply runs on instruction)
Documentation=file:///opt/trex/README.md
After=trex-hub.service
Wants=trex-hub.service

[Service]
Type=oneshot
# Plan and verify are timer-safe; --apply is never run by a unit.
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/trex/lib/trex-v2.jar egress firefly \
  --hub-url http://127.0.0.1:8090 \
  --firefly-url ${TREX_FIREFLY_URL} \
  --accounts /etc/trex/firefly.yaml \
  --plan
User=trex
Group=trex
EnvironmentFile=-/etc/trex/trex.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
