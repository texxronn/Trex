[Unit]
Description=trex gateway (consumer API: materialized journal view, rule files, decisions gateway)
Documentation=file:///opt/trex/README.md
After=trex-sequencer.service
Wants=trex-sequencer.service
PartOf=trex.target

[Service]
Type=simple
# Loopback is the design, not a default (SPEC.md §5.7): this service writes the rule
# files and forwards decisions, and it has no authentication. Expose trex-web instead.
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/trex/lib/trex-ws.jar \
  --journal /var/lib/trex/journal/journal.jsonl \
  --sequencer-url http://127.0.0.1:8080 \
  --config /etc/trex \
  --bind 127.0.0.1 --port 8085
User=trex
Group=trex
EnvironmentFile=-/etc/trex/trex.env
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
# It is the single writer of categories.yaml and pins.yaml (SPEC.md §6), so that one
# directory is writable and nothing else is.
ReadWritePaths=/etc/trex
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
ProtectHome=yes

[Install]
WantedBy=trex.target
