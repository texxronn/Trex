[Unit]
Description=trex sequencer (journal single writer + HTTP API)
Documentation=file:///opt/trex/README.md
After=network.target
PartOf=trex.target

[Service]
Type=simple
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/trex/lib/trex-sequencer.jar /etc/trex
StateDirectory=trex/journal
StateDirectoryMode=0750
ReadWritePaths=/var/lib/trex/journal
# Give in-flight requests time to finish their fsync on stop.
TimeoutStopSec=30
User=trex
Group=trex
EnvironmentFile=-/etc/trex/trex.env
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes

[Install]
WantedBy=trex.target
