[Unit]
Description=trex grid (read-only journal grid)
Documentation=file:///opt/trex/README.md
After=trex-sequencer.service
PartOf=trex.target

[Service]
Type=simple
# Read-only, but it still shows every transaction: no authentication, keep it on loopback.
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/trex/lib/trex-grid.jar \
  --journal /var/lib/trex/journal/journal.jsonl \
  --bind 127.0.0.1 --port 8091
User=trex
Group=trex
EnvironmentFile=-/etc/trex/trex.env
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes

[Install]
WantedBy=trex.target
