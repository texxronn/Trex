[Unit]
Description=trex SQLite follower (journal mirror, WAL)
Documentation=file:///opt/trex/README.md
After=trex-sequencer.service
PartOf=trex.target

[Service]
Type=simple
# Wakes on journal change events; --poll-seconds is only the fallback.
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/trex/lib/trex-egress.jar sqlite \
  --journal /var/lib/trex/journal/journal.jsonl \
  --db /var/lib/trex/sqlite/trex.db \
  --poll-seconds 60
StateDirectory=trex/sqlite
StateDirectoryMode=0750
ReadWritePaths=/var/lib/trex/sqlite
User=trex
Group=trex
EnvironmentFile=-/etc/trex/trex.env
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes

[Install]
WantedBy=trex.target
